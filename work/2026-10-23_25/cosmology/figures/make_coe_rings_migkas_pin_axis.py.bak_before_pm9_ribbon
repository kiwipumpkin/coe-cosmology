BAND_HALF = 18.0  # ±5% of 360°
STRIP_THETA_MAX = [30.0, 185.0]
STRIP_THETA_MIN = [115.0, 265.0]

MIGKAS_MAXES = [(17.0, -9.0), (185.0, 0.0)]
MIGKAS_MINS = [(115.0, 0.0), (274.0, -22.0)]

