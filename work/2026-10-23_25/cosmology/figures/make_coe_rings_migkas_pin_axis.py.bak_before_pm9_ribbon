            np.deg2rad(b),
            marker="s",
            ms=10,
            color=C_MIN,
            markeredgecolor="k",
            markeredgewidth=0.7,
            zorder=7,
            linestyle="None",
        )

    xticks = np.deg2rad(lon_disp_from_ell(np.array([180, 90, 0, 270])))
    ax.set_xticks(xticks)
    ax.set_xticklabels([r"$180^\circ$", r"$90^\circ$", r"$0^\circ$", r"$270^\circ$"], fontsize=8)
    ax.set_yticks(np.deg2rad([-60, -30, 0, 30, 60]))
    ax.set_yticklabels([r"$-60^\circ$", r"$-30^\circ$", r"$0^\circ$", r"$+30^\circ$", r"$+60^\circ$"], fontsize=8)
    ax.grid(False)
    ax.set_xlabel(r"Galactic $\ell$ (increases LEFT)", fontsize=8)
    ax.set_ylabel(r"Galactic $b$", fontsize=8)


def fill_sphere_loop(ax, D, theta_lo, theta_hi, theta_mid, color,
                      n_wash=12, n_pts=120):
    """One countable 3D belt: two strong edges + mid-line + light fill between."""
    mu_a, mu_b = mu_pair_for_band(theta_lo, theta_hi)
    mu_mid = float(np.cos(np.deg2rad(theta_mid)))
    mus = np.linspace(mu_a, mu_b, n_wash)
    # Light ribbon strips only between edges (no polar fill)
    for i in range(len(mus) - 1):
        p0 = small_circle_about_axis(D, float(mus[i]), n=n_pts)
        p1 = small_circle_about_axis(D, float(mus[i + 1]), n=n_pts)
        verts = [[p0[j], p0[j + 1], p1[j + 1], p1[j]] for j in range(n_pts - 1)]
        coll = Poly3DCollection(
            verts, facecolors=color, edgecolors="none", alpha=0.10, zorder=2
        )
        ax.add_collection3d(coll)
    # Two strong boundaries
    for mu in (mu_a, mu_b):
        pts = small_circle_about_axis(D, float(mu), n=n_pts)
        ax.plot(
            pts[:, 0], pts[:, 1], pts[:, 2],
            color=color, lw=2.4, alpha=0.98, zorder=4,
        )
    # Dashed mid-line (spine of this one belt)
    pts = small_circle_about_axis(D, mu_mid, n=n_pts)
    ax.plot(
        pts[:, 0], pts[:, 1], pts[:, 2],
        color=color, lw=2.0, alpha=0.95, zorder=5, ls="--",
    )


def panel_C_sphere(ax, geo):
    th_max = geo["theta_max_from_plus_x_deg"]
    th_min = geo["theta_min_from_plus_x_deg"]
    ax.set_title(
        r"C. Sphere 3D — two MAX + two MIN loops, each $\pm18^\circ$"
        "\n"
        r"(axis line emphasized; celestial equator dashed)",
        fontsize=10,
        pad=6,
    )
    draw_wire_sphere(ax)
    D = geo["D"]
    ell_eq, b_eq = celestial_equator_lb(400)
    eq_xyz = np.array([lb_to_n(l, b) for l, b in zip(ell_eq, b_eq)])
    ax.plot(eq_xyz[:, 0], eq_xyz[:, 1], eq_xyz[:, 2], color=C_EQ, lw=1.8, ls="--", zorder=3)
    ax.plot(
        [-D[0], D[0]],
        [-D[1], D[1]],
        [-D[2], D[2]],
        color=C_AXIS,
        lw=3.0,
        zorder=5,
    )
    ax.scatter(*(-D), color=C_COE, s=120, marker="*", edgecolors="k", linewidths=0.6,
               depthshade=False, zorder=8)
    ax.scatter(*(D), color=C_ANTI, s=80, edgecolors="k", linewidths=0.6, depthshade=False, zorder=8)
    ax.text(*(-D * 1.22), "CoE", color=C_COE, fontsize=8, fontweight="bold")
    ax.text(*(D * 1.18), "anti-CoE", color=C_ANTI, fontsize=8, fontweight="bold")
    ax.scatter([0], [0], [0], color="k", s=25, depthshade=False, zorder=9)

    for (lo, hi), mid in zip(geo["max_bands_deg"], geo["theta_max_from_plus_x_deg"]):
        fill_sphere_loop(ax, D, lo, hi, mid, C_MAX)
    for (lo, hi), mid in zip(geo["min_bands_deg"], geo["theta_min_from_plus_x_deg"]):
        fill_sphere_loop(ax, D, lo, hi, mid, C_MIN)

    for n in geo["n_maxes"]:
        ax.scatter(
            [n[0]], [n[1]], [n[2]],
            c=[C_MAX], marker="^", s=70,
            edgecolors="k", linewidths=0.7, depthshade=False, zorder=10,
        )
        ax.plot([0, n[0]], [0, n[1]], [0, n[2]], color=C_MAX, lw=0.8, ls=":", alpha=0.7)
    for n in geo["n_mins"]:
        ax.scatter(
            [n[0]], [n[1]], [n[2]],
            c=[C_MIN], marker="s", s=60,
            edgecolors="k", linewidths=0.7, depthshade=False, zorder=10,
        )
        ax.plot([0, n[0]], [0, n[1]], [0, n[2]], color=C_MIN, lw=0.8, ls=":", alpha=0.7)

    ax.set_xlim(-1.25, 1.25)
    ax.set_ylim(-1.25, 1.25)
    ax.set_zlim(-1.25, 1.25)
    ax.set_box_aspect((1, 1, 1))
    ax.view_init(elev=18, azim=-55)
    ax.set_axis_off()
    ax.text2D(
        0.5,
        -0.02,
        rf"MAX $\theta\!=\!{th_max[0]:.0f}^\circ,{th_max[1]:.0f}^\circ\pm18^\circ$; "
        rf"MIN $\theta\!=\!{th_min[0]:.0f}^\circ,{th_min[1]:.0f}^\circ\pm18^\circ$",
        transform=ax.transAxes,
        ha="center",
        fontsize=7.5,
        color="#34495e",
    )


