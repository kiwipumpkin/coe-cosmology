def _ring_lb(D, mu, n_pts=721):
    pts = small_circle_about_axis(D, mu, n=n_pts)
    rl = np.array([n_to_lb(p)[0] for p in pts])
    rb = np.array([n_to_lb(p)[1] for p in pts])
    return rl, rb


def _ring_lonlat_rad(D, mu, n_pts=361):
    """Small-circle → Mollweide display (lon_disp, lat) in radians."""
    pts = small_circle_about_axis(D, float(mu), n=n_pts)
    ls = np.array([n_to_lb(p)[0] for p in pts])
    bs = np.array([n_to_lb(p)[1] for p in pts])
    lon = np.deg2rad(lon_disp_from_ell(ls))
    lat = np.deg2rad(bs)
    return lon, lat


def fill_mollweide_loop(ax, D, theta_lo, theta_hi, theta_mid, color, n_pts=361):
    """
    One countable Mollweide loop ribbon:
      1) two strong boundary small-circles at θ_lo, θ_hi
      2) dashed mid-line at θ_mid (spine)
      3) TRUE annulus polygon fill between boundaries (no concentric wash
         strokes — those made a filled bullseye at the map center)
    Interior of MAX 30 (μ > cos(12°)) stays empty. Bands near 180° stay a
    thin annulus between cos(lo) and cos(hi); never fill through μ=−1.
    Seam-crossing quads are skipped (honest left/right arcs, no fake bridges).
    """
    mu_a, mu_b = mu_pair_for_band(theta_lo, theta_hi)
    mu_mid = float(np.cos(np.deg2rad(theta_mid)))
    lon_a, lat_a = _ring_lonlat_rad(D, mu_a, n_pts=n_pts)
    lon_b, lat_b = _ring_lonlat_rad(D, mu_b, n_pts=n_pts)
    polys = []
    gap = 0.9 * np.pi  # lon jump ⇒ antimeridian seam
    for i in range(n_pts - 1):
        if abs(lon_a[i + 1] - lon_a[i]) > gap:
            continue
        if abs(lon_b[i + 1] - lon_b[i]) > gap:
            continue
        if abs(lon_a[i] - lon_b[i]) > gap:
            continue
        if abs(lon_a[i + 1] - lon_b[i + 1]) > gap:
            continue
        polys.append([
            (lon_a[i], lat_a[i]),
            (lon_a[i + 1], lat_a[i + 1]),
            (lon_b[i + 1], lat_b[i + 1]),
            (lon_b[i], lat_b[i]),
        ])
    if polys:
        ax.add_collection(
            PolyCollection(
                polys, facecolors=color, edgecolors="none",
                alpha=0.28, zorder=2,
            )
        )
    # Two strong boundaries
    for mu in (mu_a, mu_b):
        rl, rb = _ring_lb(D, float(mu), n_pts=max(n_pts, 721))
        plot_lb_curve_mollweide(
            ax, rl, rb, color=color, lw=2.55, alpha=0.98, zorder=3
        )
    # Dashed mid-line spine
    rl, rb = _ring_lb(D, mu_mid, n_pts=max(n_pts, 721))
    plot_lb_curve_mollweide(
        ax, rl, rb, color=color, lw=2.0, alpha=0.95, zorder=4, ls="--"
    )


