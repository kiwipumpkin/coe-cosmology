\begin{document}
\section*{Harmonic fit of Migkas $A(\ell)$ set equal to the Sedov--Taylor + Gauss tidal model}

\paragraph{Model.} With $\mu=\hat n\cdot\hat D$ the cosine from the anti-CoE axis $(\ell_0,b_0)$,
\begin{equation}
\frac{A}{A_{\rm all}} = N\left[1+\alpha\kappa\,(3\mu^2-1)+\alpha\kappa\,\frac{d}{D}\left(\tfrac92\mu-\tfrac{15}{2}\mu^3\right)\right].
\end{equation}
In the Galactic plane, $\mu=c\cos x$ with $c\equiv\cos b_0$, $x\equiv\ell-\ell_0$. Using
$\cos^2x=\tfrac12(1+\cos2x)$ and $\cos^3x=\tfrac14(3\cos x+\cos3x)$, and the $90^\circ$ sector window
$W_m=\dfrac{\sin(m\pi/4)}{m\pi/4}$ ($W_1=0.900,\ W_2=0.637,\ W_3=0.300$):
\begin{align}
\frac{A}{A_{\rm all}} ={}& N\left[1+\alpha\kappa\left(\tfrac32c^2-1\right)\right]
+ N\alpha\kappa\,\frac{d}{D}\,c\left(\tfrac92-\tfrac{45}{8}c^2\right)W_1\cos x \nonumber\\
&+ N\alpha\kappa\,\tfrac32c^2\,W_2\cos2x
- N\alpha\kappa\,\frac{d}{D}\,\tfrac{15}{8}c^3\,W_3\cos3x .
\end{align}

\paragraph{Data.} Linear least squares to the 71 digitized points of Migkas et al.\ (2020), Fig.~6:
\begin{equation}
\frac{A}{A_{\rm all}} = 0.9965 + 0.0296\cos\ell + 0.0434\sin\ell + 0.0636\cos2\ell + 0.0366\sin2\ell - 0.0299\cos3\ell - 0.0114\sin3\ell,
\end{equation}
$R^2=0.915$ (dipole+quadrupole only: $R^2=0.814$). Quadrupole phase: $\ell_2=15.0^\circ$.

\paragraph{Term-by-term equality} (data coefficient of $\cos m(\ell-15^\circ)$):
\begin{align}
m=0:&\quad 0.9965 = N\left[1+\alpha\kappa\left(\tfrac32c^2-1\right)\right]\\
m=1:&\quad +0.0398 = N\alpha\kappa\,\frac{d}{D}\,c\left(\tfrac92-\tfrac{45}{8}c^2\right)W_1\\
m=2:&\quad +0.0733 = N\alpha\kappa\,\tfrac32c^2\,W_2\\
m=3:&\quad -0.0292 = -N\alpha\kappa\,\frac{d}{D}\,\tfrac{15}{8}c^3\,W_3
\end{align}

\paragraph{Manipulations.}
\begin{align}
\frac{m=1}{m=3}:&\quad \frac{\left(\tfrac92-\tfrac{45}{8}c^2\right)W_1}{-\tfrac{15}{8}c^2W_3}=\frac{0.0398}{-0.0292}
\;\Rightarrow\; c^2=0.695,\ |b_0|=33.5^\circ\\
\frac{m=3}{m=2}:&\quad \frac{0.0292}{0.0733}=\tfrac54\,c\,\frac{W_3}{W_2}\,\frac{d}{D}
\;\Rightarrow\; \frac{d}{D}=0.81\\
m=2:&\quad N\alpha\kappa=\frac{0.0733}{\tfrac32c^2W_2}=0.1105\\
m=0:&\quad N=0.9918,\qquad \alpha\kappa=0.111
\end{align}

\paragraph{Solution.} $\ell_0=15.0^\circ$, $|b_0|=33.5^\circ$, $d/D=0.81$, $\alpha\kappa=0.111$, $N=0.992$;
all four equations are satisfied exactly; $R^2=0.780$ against the 71 points.
The components perpendicular to the axis (coefficients of $\sin m(\ell-15^\circ)$: $+0.0342,\,-0.0001,\,+0.0131$)
cannot be produced by any axisymmetric model; the dipole direction $\ell_1=55^\circ$ is $40^\circ$ off axis.


\paragraph{Physical solution: $d$, $D$, $r$, $M$, $L$.}
The fit fixes ratios; the scale comes from the Migkas sample, median heliocentric redshift
$z=0.075$ (Migkas et al.\ 2020, Sect.~2), with $H_0=70\ \mathrm{km\,s^{-1}\,Mpc^{-1}}$:
\begin{align}
d &\simeq \frac{cz}{H_0}=\frac{(2.998\times10^5)(0.075)}{70}\ \mathrm{Mpc}\approx 320\ \mathrm{Mpc}\approx 1.0\ \mathrm{Gly}\\
D &= \frac{d}{d/D}=\frac{320}{0.81\ (\text{analytic})\ \text{to}\ 0.76\ (\text{full model})}\ \mathrm{Mpc}\approx 395\text{--}420\ \mathrm{Mpc}\approx 1.3\text{--}1.4\ \mathrm{Gly}\\
r &\simeq 14.3\ \mathrm{Gpc}\approx 46.5\ \mathrm{Gly}\ \ (\text{vision-shell / horizon radius, comoving}),\qquad \frac{D}{r}\approx\frac{0.40}{14.3}\approx 0.03\\
M(<D) &= \kappa\,\tfrac{4\pi}{3}\,\rho_{\rm crit}\,D^3,\qquad \rho_{\rm crit}=\frac{3H_0^2}{8\pi G}=1.36\times10^{11}\,M_\odot\,\mathrm{Mpc^{-3}}\nonumber\\
&= 0.45\times(3.5\text{--}4.3)\times10^{19}\,M_\odot\approx(1.6\text{--}1.9)\times10^{19}\,M_\odot .
\end{align}
The density scale length of the exponential core, $\rho(r)=\rho_c\,e^{-r/L}+\rho_u$ (uniform-floor fraction $f_u=0.94$, local match $\rho=0.3\rho_{\rm crit}$ at the observer), follows from the full-model $D/L=7.62$:
\begin{equation}
L=\frac{D}{D/L}=\frac{395\text{--}420}{7.62}\ \mathrm{Mpc}\approx 52\text{--}55\ \mathrm{Mpc}\approx 170\text{--}180\ \mathrm{Mly}.
\end{equation}
$L$ is degenerate with $\kappa$ along the ridge $D/L\approx6$--$9$ ($\kappa\approx0.7$--$0.3$), i.e.\ $L\approx45$--$70$ Mpc; the analytic solve does not fix $L$.
Here $\kappa\approx0.45$ is from the full numerical model (the analytic solve fixes only $\alpha\kappa=0.111$).
CoE direction: $\ell\approx195^\circ$, $|b|\approx15^\circ$ (sign of $b$ not fixed by $A(\ell)$).
For comparison, $\Omega_m=0.3$ within the same radius gives $\approx1.1\times10^{19}\,M_\odot$, so
$M(<D)\approx1.5\times$ the $\Lambda$CDM mean. Taken literally, $D\approx1.3$ Gly $\ll r\approx46.5$ Gly places the CoE well inside our vision shell ($D/r\approx0.03$), whereas a CoE beyond the horizon requires $D>r$.
A single effective depth is used; the sample spans $z=0.003$--$0.45$, and a per-cluster-redshift calculation could shift $D$.

\paragraph{Caveats.}
(i) The tidal form is first order in $d/D$, and the solution has $d/D\approx0.8$.
The full numerical model (all orders) gives a positive in-plane dipole at $b_0=0^\circ$--$15^\circ$ and
re-optimized $R^2=0.776\ (0^\circ),\ 0.777\ (15^\circ),\ 0.752\ (33.5^\circ)$, so $|b_0|=33.5^\circ$ is an
artifact of truncation; the $15^\circ$ pose stands. Full model: $\kappa\approx0.44$--$0.47$, $d/D\approx0.76$--$0.79$, $\ell_0\approx15^\circ$.
(ii) The coefficients $\tfrac92,\tfrac{15}{2}$ are point-mass values. (iii) The 71 sector points overlap and are not independent.
